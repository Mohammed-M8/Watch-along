<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <link rel="stylesheet" href="/stylesheets/partials.css">
    <title>All Requests</title>
</head>

<body>
    <%- include('../partials/_navbar.ejs') %>
        <main>
            <div class="heading">
                <h1>
                    Requests
                </h1>
                <a href="/users"><button class="button-common" type="button">Lookup Users</button></a>
            </div>
            <div class="outline">
                <div class="incoming">
                    <h3>Incoming Requests</h3>
                    <br>
                    <% if(received.length>0){
                        received.forEach(r=>{%>
                        <div class="card">
                            <div class="request-info">
                                <b>
                                    <%=r.requester.username%>
                                </b>
                                <br>
                                <%=r.status%>
                            </div>
                            <div class="request-actions">
                                <form action="/requests/<%=r._id%>?_method=PATCH" method="post">
                                    <input type="" hidden value="accept" name="action">
                                    <button type="submit" class="green">Accept</button>
                                </form>
                                <form action="/requests/<%=r._id%>?_method=PATCH" method="post">
                                    <input type="" hidden value="decline" name="action">
                                    <button type="submit" class="red">Decline</button>
                                </form>
                            </div>

                        </div>
                        <%}) }else{%>
                            <p>No incoming requests</p>
                            <%}%>
                </div>
                <div class="sent">
                    <h3>Sent Requests</h3>
                    <br>
                    <% if(sent.length>0){
                        sent.forEach(s=>{%>
                        <div class="card">
                            <div class="request-info">

                                <b>
                                    <%=s.recipient.username%>
                                </b>
                                <%=s.status%>
                            </div>
                            <div class="request-actions">
                                <form action="/requests/<%=s._id%>?_method=DELETE" method="post"><button type="submit"
                                        class="button-common">Cancel</button>
                                </form>
                            </div>
                        </div>
                        <%}) }else{%>
                            <p>No sent requests</p>
                            <%}%>
                </div>
            </div>
        </main>
</body>

</html>