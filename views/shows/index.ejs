<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script defer src="/scripts/showsSearch.js"></script>
    <link rel="stylesheet" href="/stylesheets/style.css" />

    <link rel="stylesheet" href="/stylesheets/partials.css">
    <title>Browse Shows</title>
</head>

<body>
    <%- include('../partials/_navbar.ejs') %>
        <main>
            <div class="heading">
                <h1>Search Shows</h1>
                <input class="search" id="showSearch" type="search" placeholder="search...">
            </div>
            <div class="shows" id="showsContainer">
                <%shows.forEach(s=>{%>
                    <div class="show">
                        <a class="" href="/shows/<%=s.id%>">
                            <img src="<%=s.image.medium%>">
                            <%=s.name%>

                        </a>
                    </div>

                    <%})%>
            </div>
        </main>
</body>

</html>