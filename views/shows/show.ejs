<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/stylesheets/style.css" />

    <link rel="stylesheet" href="/stylesheets/partials.css">
    <title>
        <%=showObject.name%>
    </title>
</head>

<body>
    <%- include('../partials/_navbar.ejs') %>
<main>

        <div class="show-container">
            <h1>
                <%=showObject.name%>

            </h1>
            <img src="<%=showObject.image.medium%>">
            <h2>
                <%=showObject.type%>
            </h2>
            <%showObject.genres.forEach(s=>{%>

                <div class="genre">
                    <%=s%>
                </div>
                <%})%>
        </div>
        <div class="watchalong-container">
            <h3>Watchalongs</h3>
            <p>No watchalongs</p>
        </div>
</main>
</body>

</html>