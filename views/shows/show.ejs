<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/style.css" />

    <link rel="stylesheet" href="/stylesheets/partials.css">
    <title>
        <%=showObject.name%>
    </title>
</head>

<body>
    <%- include('../partials/_navbar.ejs') %>
        <main>

            <div class="show-container">
                <div class="heading">
                    <h1>
                        <%=showObject.name%>

                    </h1>
                </div>
                <div class="show-info">
                    <img src="<%=showObject.image.medium%>" alt="<%=showObject.name%>'s Cover">
                    <div class="show-description">
                        <p><%-showObject.summary%></p>
                        <h3>Genres:</h3>
                        <%showObject.genres.forEach(s=>{%>

                            <div class="genre">
                                <%=s%>
                            </div>
                            <%})%>
                                <% if (inWatchlist) { %>

                                    <form action="/users/<%= user._id %>/watchlist/<%= showObject.id %>?_method=DELETE"
                                        method="post">
                                        <button type="submit" class="button-common">
                                            Remove from Watchlist
                                        </button>
                                    </form>

                                    <% } else { %>

                                        <form action="/users/<%=user._id%>/watchlist/<%=showObject.id%>" method="post">
                                            <button type="submit" class="button-common">
                                                Add to Watchlist
                                            </button>
                                        </form>

                                        <% } %>
                    </div>
                </div>
            </div>
            <div class="heading">
                <h2>Watchalongs</h2>
                <a href="/watchalongs/new/<%=showObject.id%>"><button type="button" class="button-common">Create
                        Watchalong</button></a>

            </div>
            <div class="outline">
                <div class=" watchalongs">

                    <%if(watchalongs.length>0){%>
                        <%watchalongs.forEach(w=>{%>
                            <div class="watchalong">
                                <a class="watchalong-content" href="/shows/<%=w.showId%>">
                                    <img src="<%=w.showImage%>" alt="<%=w.showName%> image">
                                    <h3>
                                        <%=w.showName%>
                                    </h3>
                                </a>
                                <div class="watchalong-info">
                                    <p>Season <%=w.season%>, Episode(s): <%=w.episodes.join(", ")%></p>
                                <p><%=new Date(w.scheduledAt).toLocaleString()%></p>
                                <p>Hosted By:<a href=" /users/<%=w.host._id%>" class="host"><%=w.host.username%></a>
                                    </p>
                                    <p>Participants:
                                        <%if(w.participants.length>0){%>
                                            <%w.participants.forEach(p=>{%>
                                                <a href=" /users/<%=p._id%>" class="user">
                                                    <%=p.username%>
                                                </a>

                                                <%})%>
                                                    <%}else{%>
                                                        None yet
                                                        <%}%>
                                    </p>
                                    <a href="/watchalongs/<%=w._id%>">
                                        <button type="button" class="button-common">View</button>
                                    </a>
                                </div>
                            </div>
                            <%})%>
                                <%}else{%>
                                    <p>No watchalongs in common</p>
                                    <%}%>
                </div>
            </div>

        </main>
</body>

</html>