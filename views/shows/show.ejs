<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/style.css" />

    <link rel="stylesheet" href="/stylesheets/partials.css">
    <title>
        <%=showObject.name%>
    </title>
</head>

<body>
    <%- include('../partials/_navbar.ejs') %>
        <main>

            <div class="show-container">
                <div class="heading">
                    <h1>
                        <%=showObject.name%>

                    </h1>
                </div>
                <div class="show-info">
                    <img src="<%=showObject.image.medium%>">
                    <div class="show-description">
                        <p><%-showObject.summary%></p>
                        <h3>Genres:</h3>
                        <%showObject.genres.forEach(s=>{%>

                            <div class="genre">
                                <%=s%>
                            </div>
                            <%})%>
                    </div>
                </div>
            </div>
            <div class="watchalong-container">
                <h3>Watchalongs</h3>
                <%if(watchalongs.length>0){

                    watchalongs.forEach(w=>{
                    %>
                    <%=w.scheduledAt%>

                        <%})%>
                            <%}else{%>
                                <p>No watchalongs</p>
                                <%}%>
            </div>
        </main>
</body>

</html>