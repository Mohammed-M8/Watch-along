<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%=userObject.username%>'s page
    </title>
</head>

<body>
    <%- include('../partials/_navbar.ejs') %>
        <h1>
            <%=userObject.username%>'s page
        </h1>
        <div class="outline">
            <%=userObject.username%>
                <form action="/requests" method="post">
                    <input type="text" name="recipient" value="<%=userObject._id%>" hidden>
                    <button type="submit">Send Friend Request</button>
                </form>
        </div>
</body>

</html>