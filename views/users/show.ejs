<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/style.css" />

    <link rel="stylesheet" href="/stylesheets/partials.css">
    <title>
        <%=userObject.username%>'s page
    </title>
</head>

<body>
    <%- include('../partials/_navbar.ejs') %>
        <main>
            <div class="heading">
                <h1>
                    <%=userObject.username%>'s page
                </h1>
            </div>
            <div class="outline">
                <div class="info">
                    <%=userObject.username%>
                        <% if (!isFriend && (status!=='pending' )) { %>

                            <form action="/requests" method="post">
                                <input type="hidden" name="recipient" value="<%= userObject._id %>">
                                <button type="submit" class="button-common">Send Friend Request</button>
                            </form>

                            <% } else if (status==='pending' ) { %>

                                <form action="/requests/<%=userObject._id%>?_method=DELETE" method="post"><button
                                        type="submit" class="button-common">Cancel Request</button>
                                </form>

                                <% } else if (isFriend) { %>

                                    <form action="/users/<%=user._id%>/friends/<%=userObject._id%>?_method=DELETE"
                                        method="post">
                                        <button type="submit" class="button-common">Remove Friend</button>
                                    </form>

                                    <% } %>
                </div>
                <%=friendCount%> friends
            </div>
        </main>
</body>

</html>