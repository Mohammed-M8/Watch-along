<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/style.css" />

    <link rel="stylesheet" href="/stylesheets/partials.css">
    <title>
        <%=userObject.username%>'s page
    </title>
</head>

<body>
    <%- include('../partials/_navbar.ejs') %>
        <main>
            <div class="heading">
                <h1>
                    <%=userObject.username%>'s page
                </h1>
            </div>
            <div class="outline">
                <div class="info">
                    <%=userObject.username%>
                        <% if (!isFriend && (status!=='pending' )) { %>

                            <form action="/requests" method="post">
                                <input type="hidden" name="recipient" value="<%= userObject._id %>">
                                <button type="submit" class="button-common">Send Friend Request</button>
                            </form>

                            <% } else if (status==='pending' ) { %>

                                <form action="/requests/<%=userObject._id%>?_method=DELETE" method="post"><button
                                        type="submit" class="button-common">Cancel Request</button>
                                </form>

                                <% } else if (isFriend) { %>

                                    <form action="/users/<%=user._id%>/friends/<%=userObject._id%>?_method=DELETE"
                                        method="post">
                                        <button type="submit" class="button-common">Remove Friend</button>
                                    </form>

                                    <% } %>
                </div>
                <%=friendCount%> friends
            </div>
            <div class="heading">
                <h2>Connected Watchalongs</h2>
            </div>
            <div class="outline">
                <div class=" watchalongs">

                    <%if(watchalongs.length>0){%>
                        <%watchalongs.forEach(w=>{%>
                            <div class="watchalong">
                                <a class="watchalong-content" href="/shows/<%=w.showId%>">
                                    <img src="<%=w.showImage%>" alt="<%=w.showName%> image">
                                    <h3>
                                        <%=w.showName%>
                                    </h3>
                                </a>
                                <div class="watchalong-info">
                                    <p>Season <%=w.season%>, Episode(s): <%=w.episodes.join(", ")%></p>
                                <p><%=new Date(w.scheduledAt).toLocaleString()%></p>
                                <p>Hosted By:<a href=" /users/<%=w.host._id%>" class="host"><%=w.host.username%></a>
                                    </p>
                                    <p>Participants:
                                        <%if(w.participants.length>0){%>
                                            <%w.participants.forEach(p=>{%>
                                                <a href=" /users/<%=p._id%>" class="user">
                                                    <%=p.username%>
                                                </a>

                                                <%})%>
                                                    <%}else{%>
                                                        None yet
                                                        <%}%>
                                    </p>
                                    <a href="/watchalongs/<%=w._id%>">
                                        <button type="button" class="button-common">View</button>
                                    </a>
                                </div>
                            </div>
                            <%})%>
                                <%}else{%>
                                    <p>No watchalongs in common</p>
                                    <%}%>
                </div>
            </div>
        </main>
</body>

</html>