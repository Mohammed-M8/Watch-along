<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%=userObject.username%>'s page
    </title>
</head>

<body>
    <%- include('../partials/_navbar.ejs') %>
        <h1>
            <%=userObject.username%>'s page
        </h1>
        <div class="outline">
            <%=userObject.username%>
                <% if (!isFriend && (status!=='pending' )) { %>

                    <form action="/requests" method="post">
                        <input type="hidden" name="recipient" value="<%= userObject._id %>">
                        <button type="submit">Send Friend Request</button>
                    </form>

                    <% } else if (status==='pending' ) { %>

                        <p>Request is Pending</p>

                        <% } else if (isFriend) { %>

                            <form action="/users/<%=user._id%>/friends/<%=userObject._id%>?_method=DELETE"
                                method="post"><button type="submit">Remove X</button></form>

                            <% } %>
        </div>
</body>

</html>