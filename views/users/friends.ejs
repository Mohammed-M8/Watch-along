<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/stylesheets/style.css" />

    <link rel="stylesheet" href="/stylesheets/partials.css">
    <title>
        Friends
    </title>
</head>

<body>
    <%- include('../partials/_navbar.ejs') %>
<main>        <h1>
            Friends List
        </h1>
        <a href="/requests">View Requests</a>
        <%if(friends.length===0){%>
            <p>Empty List</p>
            <%}else{ friends.forEach(f=>{%>
                <%=f.username%>
                <form action="/users/<%=user._id%>/friends/<%=f._id%>?_method=DELETE" method="post"><button type="submit">Remove X</button></form>
                    <%}) }%>

</main>
</body>

</html>