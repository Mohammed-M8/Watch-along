<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/style.css" />

    <link rel="stylesheet" href="/stylesheets/partials.css">
    <title>
        Friends
    </title>
</head>

<body>
    <%- include('../partials/_navbar.ejs') %>
        <main>
            <div class="heading">
                <h1>
                    Friends List
                </h1>
                <a href="/requests"><button class="button-common" type="button">View Requests</button></a>
            </div>

            <div class="friends-list">
                <%if(friends.length===0){%>
                    <div class="friend">
                        <p>Empty List</p>
                    </div>
                    <%}else{ friends.forEach(f=>{%>
                        <div class="friend">
                            <%=f.username%>
                                <div class="friends-actions">
                                    <a href="/users/<%=f._id%>">
                                        View
                                    </a>
                                    <form action="/users/<%=user._id%>/friends/<%=f._id%>?_method=DELETE" method="post">
                                        <button class="button-common" type="submit">Remove Friend</button>
                                    </form>
                                </div>

                        </div>
                        <%}) }%>
            </div>

        </main>
</body>

</html>