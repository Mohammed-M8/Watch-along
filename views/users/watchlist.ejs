<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/style.css" />

    <link rel="stylesheet" href="/stylesheets/partials.css">
    <title>
        Your Watchlist
    </title>
</head>

<body>
    <%- include('../partials/_navbar.ejs') %>
        <main>
            <div class="heading">
                <h1>
                    Your Watchlist
                </h1>
                <a href="/shows"><button type="button" class="button-common">Browse Shows</button></a>
            </div>
            <div class="outline">
                <%if(watchlist.length>0){%>
                    <div class="shows">
                        <%watchlist.forEach(w=>{%>
                            <div class="show">
                                <a href="/shows/<%=w.showId%>">
                                    <img src="<%=w.image%>" alt="<%=w.name%> image">
                                    <%=w.name%>

                                </a>
                            </div>
                            <%})%>
                    </div>
                    <%}else{%>
                        <p>No shows in Watchlist</p>
                        <%}%>
            </div>
        </main>
</body>

</html>