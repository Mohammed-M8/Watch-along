<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/partials.css">

    <title>
        <%= user.username %>'s Profile
    </title>
</head>

<body>

    <%- include('../partials/_navbar.ejs') %>

    <main>
        <div class="heading">
            <h1>
                <%= user.username %>'s Profile
            </h1>

            <form action="/users/<%= user._id %>/edit" method="get">
                <button type="submit" class="button-common">
                    Edit Profile
                </button>
            </form>
        </div>

        <div class="outline">
            <div class="info">
                <p>Username: <%= user.username %></p>
                <p>Email: <%= user.email %></p>
                <p><%= user.friends.length %> friends</p>
            </div>
        </div>
    </main>

</body>

</html>