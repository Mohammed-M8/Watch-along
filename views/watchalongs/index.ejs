<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/style.css" />

    <link rel="stylesheet" href="/stylesheets/partials.css">
    <title>My Watchalongs</title>
</head>

<body>
    <%- include('../partials/_navbar.ejs') %>
        <main>
            <div class="heading">
                <h1>
                    Watchalongs Scheduled
                </h1>
                <a href="/shows"><button type="button" class="button-common">Browse Shows</button></a>
            </div>
            <div class="outline">
                <div class="heading">
                    <h2>Hosted Watchalongs</h2>
                    <a href="/shows"><button type="button" class="button-common">Create Watchalong</button></a>
                </div>
                <div class="hosted">

                    <%if(hosted.length>0){%>
                        <%hosted.forEach(h=>{%>
                            <div class="watchalong">
                                <a class="watchalong-content" href="/shows/<%=h.showId%>">
                                    <img src="<%=h.showImage%>" alt="<%=h.showName%> image">
                                    <h3>
                                        <%=h.showName%>
                                    </h3>
                                </a>
                                <div class="watchalong-info">
                                    <p>Season <%=h.season%>, Episode(s): <%=h.episodes.join(", ")%></p>
                                <p><%=new Date(h.scheduledAt).toLocaleString()%></p>
                                <p>Participants:
                                    <%if(h.participants.length>0){%>
                                      <%h.participants.forEach(p=>{%>
<a href=" /users/<%=p._id%>" class="user"><%=p.username%></a>

                                                    <%})%>
                                                        <%}else{%>
                                                            None yet
                                                            <%}%>
                                    </p>
                                    <p>Invited:
                                        <%if(h.invitedUsers.length>0){%>
                                            <%h.invitedUsers.forEach(i=>{%>
                                                <a href=" /users/<%=i._id%>" class="user">
                                                    <%=i.username%>
                                                </a>

                                                <%})%>
                                                    <%}else{%>
                                                        None yet
                                                        <%}%>
                                    </p>
                                    <a href="/watchalongs/<%=h._id%>">
                                        <button type="button" class="button-common">View</button>
                                    </a>
                                </div>

                            </div>
                            <%})%>
                                <%}else{%>
                                    <p>No watchalongs hosted.</p>
                                    <%}%>
                </div>
                <div class=" heading">
                    <h2>Participated Watchalongs</h2>
                    <a href="/watchalongs/invites"><button type="button" class="button-light">View
                            Invites</button></a>
                </div>
                <div class=" added">

                    <%if(added.length>0){%>
                        <%added.forEach(a=>{%>
                            <div class="watchalong">
                                <a class="watchalong-content" href="/shows/<%=a.showId%>">
                                    <img src="<%=a.showImage%>" alt="<%=a.showName%> image">
                                    <h3>
                                        <%=a.showName%>
                                    </h3>
                                </a>
                                <div class="watchalong-info">
                                    <p>Season <%=a.season%>, Episode(s): <%=a.episodes.join(", ")%></p>
                                <p><%=new Date(a.scheduledAt).toLocaleString()%></p>
                                <p>Hosted By:<a href=" /users/<%=a.host._id%>" class="host"><%=a.host.username%></a>
                                    </p>
                                    <p>Participants:
                                        <%if(a.participants.length>0){%>
                                            <%a.participants.forEach(p=>{%>
                                                <a href=" /users/<%=p._id%>" class="user">
                                                    <%=p.username%>
                                                </a>

                                                <%})%>
                                                    <%}else{%>
                                                        None yet
                                                        <%}%>
                                    </p>
                                    <a href="/watchalongs/<%=a._id%>">
                                        <button type="button" class="button-common">View</button>
                                    </a>
                                </div>
                            </div>
                            <%})%>
                                <%}else{%>
                                    <p>No watchalongs added to.</p>
                                    <%}%>
                </div>

            </div>
        </main>
</body>

</html>