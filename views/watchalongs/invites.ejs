<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <link rel="stylesheet" href="/stylesheets/partials.css">
    <title>Invites</title>
</head>

<body>
    <%- include('../partials/_navbar.ejs') %>

        <main>
            <div class="heading">
                <h1>Watchalong Invites</h1>
                <a href="/watchalongs">
                    <button type="button" class="button-light">My Watchalongs</button>
                </a>
            </div>

            <div class="outline">

                <% if (watchalongs.length> 0) { %>

                    <% watchalongs.forEach(w=> { %>

                        <div class="watchalong">

                            <a href="/shows/<%= w.showId %>">
                                <img src="<%= w.showImage %>" alt="<%= w.showName %> image">

                                <h3>
                                    <%= w.showName %>
                                </h3>
                            </a>

                            <div class="watchalong-info">

                                <p>
                                    Season <%= w.season %>, Episode(s):
                                        <%= w.episodes.join(", ") %>
                                </p>

                                <p>
                                    <%= new Date(w.scheduledAt).toLocaleString() %>
                                </p>

                                <p>
                                    Hosted by:
                                    <%= w.host ? w.host.username : " Unknown" %>
                                </p>

                                <div class="watchalong-actions">

                                    <form action="/watchalongs/<%= w._id %>?_method=PATCH" method="POST">
                                        <input type="hidden" name="action" value="accept">
                                        <button type="submit" class="green">
                                            Accept
                                        </button>
                                    </form>

                                    <form action="/watchalongs/<%= w._id %>?_method=PATCH" method="POST">
                                        <input type="hidden" name="action" value="decline">
                                        <button type="submit" class="red">
                                            Decline
                                        </button>
                                    </form>

                                </div>

                            </div>
                        </div>

                        <% }) %>

                            <% } else { %>

                                <p>No watchalong invites.</p>

                                <% } %>

            </div>
        </main>
</body>

</html>